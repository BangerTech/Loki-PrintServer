# Loki-PrintServer Configuration
# Copy this file to .env and customize

# USB/IP protocol port (clients connect here for USB tunneling)
LOKI_PORT=7575

# Management API & Web Dashboard port
LOKI_API_PORT=7576

# Optional: Set a secret key to require authentication
# Leave empty for open access (trusted network only!)
LOKI_SECRET=

# Allow all connected USB devices to be shareable
LOKI_ALLOW_ALL=true
